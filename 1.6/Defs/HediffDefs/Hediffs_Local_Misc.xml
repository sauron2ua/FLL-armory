<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <HediffDef>
    <defName>FLL_Sting</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <defaultLabelColor>(15, 15, 15)</defaultLabelColor>
    <description>Stings in target`s body temporarily restricts the movement in exchange for reduced damage.</description>
    <label>Supression stings</label>

    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1000~1500</disappearsAfterTicks>
        <showRemainingTime>true</showRemainingTime>
      </li>   
    </comps>
    <stages>

      <li>
        <label>Slowdown</label>
        <minSeverity>0.80</minSeverity>
        <statOffsets>
          <MoveSpeed>-0.8</MoveSpeed>
        </statOffsets>
      </li>
    </stages>
  </HediffDef>

</Defs>
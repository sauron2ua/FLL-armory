			</skillRequirements>			
		</recipeMaker>			
		<costList>
			<Plasteel>150</Plasteel>
			<Uranium>25</Uranium>
			<ComponentSpacer>4</ComponentSpacer>
		</costList>
		<thingSetMakerTags>
			<li>RewardStandardLowFreq</li>
			<li>RewardStandardQualitySuper</li>
		</thingSetMakerTags>

		<tradeability>Sellable</tradeability>
		<recipeMaker Inherit="False"/>

		<comps>
			<li Class="CompProperties_Art">
				<nameMaker>NamerArtWeaponGun</nameMaker>
				<descriptionMaker>ArtDescription_WeaponGun</descriptionMaker>
				<minQualityForArtistic>Excellent</minQualityForArtistic>
			</li>
			<li>
				<compClass>CompQuality</compClass>
			</li>
		</comps>
		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Beam_Eruptor</defaultProjectile>
				<aimingLineMote>Mote_HellsphereCannon_Aim</aimingLineMote>
				
				<warmupTime>4</warmupTime>
				<range>33</range>
				<ticksBetweenBurstShots>15</ticksBetweenBurstShots>
				<burstShotCount>20</burstShotCount>
				<soundCast>FLL_Eruptor_shot</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>9</muzzleFlashScale>
			</li>
		</verbs>
		<tools>
			<li>
				<label>stock</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>10</power>
				<cooldownTime>3</cooldownTime>
			</li>
			<li>
				<label>barrel</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>8</power>
				<cooldownTime>2.8</cooldownTime>
			</li>
	
		</tools>
		<tradeTags>
    	</tradeTags>
	</ThingDef>

<!-- ================================= Desintegrator (UNFINISHED) ==================================== -->
	<!-- Ultraheavy siege weapon, aka human variant of hellspire cannon with three explosive beams -->
 	<ThingDef ParentName="BaseBullet">

    	<defName>Bullet_Desintegrator</defName>
    	<label>hellsphere cannon shot</label>
		<thingClass>Projectile_Explosive</thingClass>
    	<graphicData>
      		<texPath>Things/Projectile/HellsphereCannon</texPath>
      		<graphicClass>Graphic_Single</graphicClass>
      		<shaderType>MoteGlow</shaderType>
      		<drawSize>(1.5, 3)</drawSize>
    	</graphicData>
    	<projectile>
      		<damageDef>Vaporize</damageDef>
      		<speed>70</speed>
      		<explosionRadius>2.4</explosionRadius>
      		<screenShakeFactor>1</screenShakeFactor>
      		<filth>Filth_BlastMark</filth>
      		<filthCount>1</filthCount>
      		<explosionSpawnsSingleFilth>true</explosionSpawnsSingleFilth>
    	</projectile>
  	</ThingDef>

	<ThingDef ParentName="BaseHumanMakeableGun">
		<defName>FLL_Gun_Desintegrator</defName>
		<label>Desintegrator cannon</label>
		<description>Reverse engineered Hellspire cannon to be usable with human hands. As its original counterpart, designed to breach fortifications, especially spaceship hulls. Due to rather crude mechanisms, weapons range literally reversed, being effective only from far distances</description>
		<techLevel>Spacer</techLevel>
		<graphicData>
			<texPath>Things/Item/Equipment/WeaponRanged/Desintegrator</texPath>
			<graphicClass>Graphic_Single</graphicClass>
			<shaderType>TransparentPostLight</shaderType>
		</graphicData>
		<soundInteract>Interact_Rifle</soundInteract>		
		
		<weaponClasses>

		</weaponClasses>

		<weaponTags>
			
		</weaponTags>

		<statBases>
			<MarketValue>6000</MarketValue>
			<Mass>30</Mass>
			<AccuracyTouch>0.30</AccuracyTouch>
			<AccuracyShort>0.40</AccuracyShort>
			<AccuracyMedium>0.40</AccuracyMedium>
			<AccuracyLong>0.20</AccuracyLong>
			<RangedWeapon_Cooldown>4</RangedWeapon_Cooldown>
		</statBases>
		<equippedAngleOffset>45</equippedAngleOffset>
		<recipeMaker>
			<researchPrerequisites>
				<li>FLL_MechanoidSalvage</li>
				<li>BeamWeapons</li>
				<li>FLL_LegionaryArsenal</li>
			</researchPrerequisites>
			<skillRequirements>
				<Crafting>16</Crafting>
			</skillRequirements>			
		</recipeMaker>			
		<costList>
			<Plasteel>500</Plasteel>
			<ComponentSpacer>7</ComponentSpacer>
			<HellsphereCore>1</HellsphereCore>
		</costList>
		<thingSetMakerTags>

		</thingSetMakerTags>

		<tradeability>Sellable</tradeability>

		<verbs>
			<li>
				<verbClass>Verb_Shoot</verbClass>
				<hasStandardCommand>true</hasStandardCommand>
				<defaultProjectile>Bullet_Desintegrator</defaultProjectile>
				<aimingLineMote>Mote_HellsphereCannon_Aim</aimingLineMote>
				<minRange>16</minRange>
				<warmupTime>15</warmupTime>
				<range>42</range>
				<ticksBetweenBurstShots>33</ticksBetweenBurstShots>
				<burstShotCount>3</burstShotCount>
				<soundCast>FLL_Eruptor_shot</soundCast>
				<soundCastTail>GunTail_Medium</soundCastTail>
				<muzzleFlashScale>16</muzzleFlashScale>
				<forcedMissRadius>6</forcedMissRadius>
				<requireLineOfSight>true</requireLineOfSight>
				<targetParams>
					<canTargetLocations>true</canTargetLocations>
					<canTargetPawns>false</canTargetPawns>
				</targetParams>
        		<soundAiming>HellsphereCannon_Aiming</soundAiming>		
				<aimingChargeMote>Mote_HellsphereCannon_Charge</aimingChargeMote>	
				<aimingTargetMote>Mote_HellsphereCannon_Target</aimingTargetMote>	
        		<aimingLineMoteFixedLength>15.9</aimingLineMoteFixedLength>

				<canGoWild>false</canGoWild>

				<ai_IsBuildingDestroyer>true</ai_IsBuildingDestroyer>
			</li>
		</verbs>
		<tools>
			<li>
				<label>Claws</label>
				<capacities>
					<li>Blunt</li>
					<li>Poke</li>
				</capacities>
				<power>7</power>
				<cooldownTime>5</cooldownTime>
			</li>
	
		</tools>
		<relicChance>0</relicChance>
		<tradeTags>
    	</tradeTags>
	</ThingDef>

</Defs>